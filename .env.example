# Google Gemini API Key (get free from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Database
DATABASE_URL=sqlite:///./document_intelligence.db

# Upload directory
UPLOAD_DIR=uploads

# Logging
LOG_LEVEL=INFO

# Financial validation tolerance (as decimal, e.g., 0.01 = 1%)
FINANCIAL_TOLERANCE=0.01
